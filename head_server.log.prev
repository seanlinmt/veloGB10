[req] tool_call  call_319 edit({"newString":"  const rows = (res.data ?? []) as MembershipRow[];\n  const memberships: MembershipView[] = [];\n  for (const row of rows) {\n    // Normalise the embed shape (object or single-element array); skip a\n    // membership whose organization row is missing.\n    const org = Array.isArray(row.organizations)\n      ? row.organizations[0] ?? null\n      : row.organizations;\n    if (!org) continue;\n    memberships.push({\n      organizationId: row.organization_id,\n      organizationName: org.legal_name,\n      nzbn: org.nzbn,\n      role: row.user_role,\n    });\n  }\n  return { ok: true, data: memberships };","oldString":"  const rows = (res.data ?? []) as MembershipRow[];\n  const memberships: MembershipView[] = [];\n  for (const row of rows) {\n    // Defensive: skip a membership whose organization row is missing.\n    if (!row.organizations) continue;\n    memberships.push({\n      organizationId: row.organization_id,\n      organizationName: row.organizations.legal_name,\n      nzbn: row.organizations.nzbn,\n      role: row.user_role,\n    });\n  }\n  return { ok: true, data: memberships };","path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/server/loaders.ts"})
