[req] tool_call  call_405 edit({"newString":"  # ---------------------------------------------------------------------------\n  # Lane 2 — release on takahe + post-deploy smoke.\n  # Runs on the SELF-HOSTED runner registered on the sovereign host (see the\n  # header comment for the label contract + SSH fallback secret names).\n  # Dispatch-triggered releases WAIT for build-and-push: a concurrent pull of\n  # `latest` would race the push and could deploy the PREVIOUS image. On\n  # repository_dispatch, build-and-push is skipped (the event releases an\n  # already-built image), so 'skipped' is an accepted result.\n  # ---------------------------------------------------------------------------\n  deploy-takahe:\n    needs: build-and-push\n    if: >-\n      (needs.build-and-push.result == 'success' || needs.build-and-push.result == 'skipped') &&\n      (github.event_name == 'repository_dispatch' ||\n       (github.event_name == 'workflow_dispatch' && inputs.deploy_app && !inputs.emit_dispatch_only))","oldString":"  # ---------------------------------------------------------------------------\n  # Lane 2 — release on takahe + post-deploy smoke.\n  # Runs on the SELF-HOSTED runner registered on the sovereign host (see the\n  # header comment for the label contract + SSH fallback secret names).\n  # ---------------------------------------------------------------------------\n  deploy-takahe:\n    if: >-\n      github.event_name == 'repository_dispatch' ||\n      (github.event_name == 'workflow_dispatch' && inputs.deploy_app && !inputs.emit_dispatch_only)","path":"/Users/sean/Desktop/TenderPulseNZ/.github/workflows/deploy.yml"})
[req] tool_call  call_406 edit({"newString":"#   2. deploy-takahe   (manual workflow_dispatch — which waits for\n#      build-and-push — or a repository_dispatch\n#      event) — pulls the freshly pushed image on the sovereign host `takahe`","oldString":"#   2. deploy-takahe   (manual workflow_dispatch, or a repository_dispatch\n#      event) — pulls the freshly pushed image on the sovereign host `takahe`","path":"/Users/sean/Desktop/TenderPulseNZ/.github/workflows/deploy.yml"})
