[req] tool_call  call_210 write({"content":"import { getCurrentOrgId, getCurrentUserRole } from \"@/lib/auth/tenant\";\nimport {\n  loadOpportunities,\n  loadAuditLogs,\n  loadLatestBid,\n  loadActiveOrganization,\n  loadUserMemberships,\n  loadVaultOverview,\n} from \"@/features/copilot/server/loaders\";\nimport { AppShell } from \"@/features/copilot/ui/app-shell\";\n\nexport const dynamic = \"force-dynamic\";\n\n/**\n * Copilot dashboard — server entry point.\n *\n * This is a Server Component: it resolves the active tenant, loads the\n * tenant-scoped opportunities, compliance vault, audit ledger, most recent\n * bid, the real `organizations` row, and the user's ACTIVE memberships\n * directly from Supabase via the copilot loaders, and hands the typed\n * {@link LoaderResult} unions down to the client {@link AppShell}. There are\n * no mock fallbacks: a failed load renders an honest error pane per tab, an\n * empty load renders the screens' honest empty states, and an authenticated\n * user with no tenant sees the onboarding prompt below.\n */\nexport default async function DashboardPage() {\n  const orgId = await getCurrentOrgId();\n\n  if (!orgId) {\n    return <NoTenantState />;\n  }\n\n  // Load the six independent data sets in parallel. Each degrades to its own\n  // `{ ok: false, error }` union — none masks another with mock data.\n  const [opps, audit, bid, org, memberships, vault] = await Promise.all([\n    loadOpportunities(orgId),\n    loadAuditLogs(orgId),\n    loadLatestBid(orgId),\n    loadActiveOrganization(orgId),\n    loadUserMemberships(),\n    loadVaultOverview(orgId),\n  ]);\n\n  const userRole = await getCurrentUserRole();\n\n  return (\n    <AppShell\n      orgId={orgId}\n      organization={org.ok ? org.data : null}\n      organizationError={org.ok ? null : org.error}\n      memberships={memberships.ok ? memberships.data : []}\n      membershipsError={memberships.ok ? null : memberships.error}\n      userRole={userRole}\n      opportunities={opps}\n      vault={vault}\n      auditEntries={audit}\n      bid={bid}\n    />\n  );\n}\n\n/**\n * Honest no-tenant state.\n *\n * The middleware guarantees a session on `/dashboard`, so reaching here means\n * the signed-in user holds no active `organization_members` row. Rather than\n * dressing the dashboard in a mock org, we say exactly that and point at the\n * NZBN onboarding on `/vault`.\n */\nfunction NoTenantState(): React.ReactNode {\n  return (\n    <main\n      style={{\n        minHeight: \"100vh\",\n        display: \"grid\",\n        placeItems: \"center\",\n        padding: \"var(--space-8)\",\n        background: \"var(--bg)\",\n      }}\n    >\n      <div\n        className=\"state-card\"\n        role=\"status\"\n        style={{ maxWidth: 560, textAlign: \"center\", gap: \"var(--space-3)\" }}\n        data-od-id=\"screen-no-tenant\"\n      >\n        <h1 className=\"screen-title\" style={{ margin: 0 }}>\n          No organisation selected\n        </h1>\n        <p style={{ margin: 0, color: \"var(--muted)\" }}>\n          You are signed in, but this account is not an active member of any\n          organisation yet. Onboard your NZBN to get a tenant workspace —\n          opportunities, the compliance vault, the bid drafter, and the audit\n          ledger all scope to it.\n        </p>\n        <p style={{ margin: 0 }}>\n          <a className=\"btn btn-primary\" href=\"/vault\">\n            Onboard an organisation in the Compliance Vault\n          </a>\n        </p>\n      </div>\n    </main>\n  );\n}","path":"/Users/sean/Desktop/TenderPulseNZ/src/app/(copilot)/dashboard/page.tsx"})
