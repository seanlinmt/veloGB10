[req] tool_call  call_193 write({"path":"/private/var/folders/38/srn8463155lf5fds8tbc2lgm0000gn/T/opencode/tpnz-brief-template.html","content":"<!DOCTYPE html>\n<html lang=\"en-NZ\">\n<head>\n<meta charset=\"utf-8\">\n<style>\n  @page {\n    size: A4;\n    margin: 22mm 18mm 20mm 18mm;\n  }\n  * { box-sizing: border-box; }\n  html, body { margin: 0; padding: 0; }\n  body {\n    font-family: \"Helvetica Neue\", Helvetica, Arial, sans-serif;\n    font-size: 10.5pt;\n    line-height: 1.55;\n    color: #1C2733;\n  }\n  .run-head, .run-foot {\n    position: fixed;\n    left: 0;\n    right: 0;\n    font-size: 7.5pt;\n    letter-spacing: 0.06em;\n    color: #5B6B7F;\n    text-transform: uppercase;\n  }\n  .run-head { top: 4mm; }\n  .run-foot { bottom: 3mm; display: flex; justify-content: space-between; }\n  h1 {\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 18.5pt;\n    line-height: 1.25;\n    color: #16324F;\n    margin: 0 0 14px;\n    padding-bottom: 10px;\n    border-bottom: 2px solid #16324F;\n  }\n  h2 {\n    font-family: Georgia, \"Times New Roman\", serif;\n    font-size: 13pt;\n    color: #16324F;\n    margin: 26px 0 8px;\n    padding-bottom: 4px;\n    border-bottom: 1px solid #D3DCE6;\n    page-break-after: avoid;\n  }\n  h3 {\n    font-size: 11pt;\n    color: #16324F;\n    margin: 18px 0 6px;\n    page-break-after: avoid;\n  }\n  p { margin: 0 0 9px; orphans: 3; widows: 3; text-align: justify; }\n  strong { color: #16324F; }\n  blockquote {\n    margin: 12px 0;\n    padding: 9px 14px;\n    border-left: 3px solid #16324F;\n    background: #F2F6FA;\n    font-size: 10pt;\n    page-break-inside: avoid;\n  }\n  blockquote p { margin: 0; }\n  table {\n    width: 100%;\n    border-collapse: collapse;\n    margin: 12px 0 14px;\n    font-size: 9pt;\n    line-height: 1.4;\n  }\n  th, td {\n    border: 1px solid #C6CFDA;\n    padding: 5px 8px;\n    vertical-align: top;\n    text-align: left;\n  }\n  th { background: #E9EFF5; color: #16324F; }\n  tr {