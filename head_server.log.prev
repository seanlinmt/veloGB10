[req] tool_call  call_185 write({"content":"import { IconLogo, IconBuilding, IconBell } from \"./icons\";\nimport { AmotaiBadge } from \"./status-badge\";\nimport { OrgSwitcher } from \"./org-switcher\";\nimport type { MembershipView, OrganizationView } from \"../server/types\";\n\n/** Human-readable label for an `organization_members.user_role` value. */\nconst ROLE_LABELS: Record<string, string> = {\n  admin: \"Administrator\",\n  bid_manager: \"Bid manager\",\n  viewer: \"Viewer\",\n};\n\nfunction roleLabel(role: string | null): string {\n  if (!role) return \"Role unavailable\";\n  return ROLE_LABELS[role] ?? role;\n}\n\n/**\n * Copilot app header — Server-safe presentational component.\n *\n * Shows the REAL active organisation (legal/trading name + NZBN from the\n * `organizations` row), the real Amotai certification flag, the org switcher\n * (real memberships via `organization_members`), and the signed-in user's\n * real tenant role. When the organization row could not be loaded it says so\n * honestly instead of falling back to prototype copy.\n */\ninterface HeaderProps {\n  activeOrgId: string;\n  organization: OrganizationView | null;\n  organizationError: string | null;\n  memberships: MembershipView[];\n  membershipsError: string | null;\n  userRole: string | null;\n  /** Count of high-match (≥80%) scored lots; null when unavailable. */\n  highMatchCount: number | null;\n  onShowOpportunities: () => void;\n}\n\nexport function Header({\n  activeOrgId,\n  organization,\n  organizationError,\n  memberships,\n  membershipsError,\n  userRole,\n  highMatchCount,\n  onShowOpportunities,\n}: HeaderProps) {\n  const orgName = organization\n    ? organization.tradingName ?? organization.legalName\n    : \"Organisation profile unavailable\";\n\n  const notifLabel =\n    highMatchCount === null\n      ? \"Open scored opportunities (high-match count unavailable)\"\n      : `${highMatchCount} high-match GETS lots available`;\n\n  return (\n    <header className=\"app-header\" role=\"banner\">\n      <div className=\"header-left\">\n        <a href=\"/dashboard\" className=\"brand-group\" aria-label=\"TenderPulse NZ dashboard home\">\n          <div className=\"brand-logo-mark\">\n            <IconLogo size={20} />\n          </div>\n          <span className=\"brand-title\">TenderPulse NZ</span>\n          <span className=\"brand-tag\">GovTech Copilot</span>\n        </a>\n\n        <div\n          className=\"entity-switcher\"\n          role=\"region\"\n          aria-label=\"Current organisation details and switcher\"\n        >\n          <span className=\"entity-icon\">\n            <IconBuilding size={16} />\n          </span>\n          <div>\n            <span className=\"entity-name\" title={organizationError ?? undefined}>\n              {orgName}\n            </span>\n            {organization ? (\n              <span className=\"entity-nzbn\"> · NZBN: {organization.nzbn}</span>\n            ) : null}\n          </div>\n          {organization?.isAmotaiCertified ? <AmotaiBadge text=\"Amotai certified\" /> : null}\n\n          <OrgSwitcher\n            memberships={memberships}\n            membershipsError={membershipsError}\n            activeOrgId={activeOrgId}\n          />\n        </div>\n      </div>\n\n      <div className=\"header-right\">\n        <button\n          className=\"notif-trigger\"\n          type=\"button\"\n          aria-label={notifLabel}\n          onClick={onShowOpportunities}\n        >\n          <IconBell size={16} />\n          <span>High-Match Tenders</span>\n          <span className=\"notif-count\">{highMatchCount ?? \"—\"}</span>\n        </button>\n\n        <div style={{ fontSize: \"var(--fs-xs)\", textAlign: \"right\" }}>\n          <div style={{ fontWeight: 600, color: \"var(--fg)\" }}>Signed in</div>\n          <div style={{ color: \"var(--muted)\" }}>{roleLabel(userRole)}</div>\n        </div>\n      </div>\n    </header>\n  );\n}","path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/ui/header.tsx"})
