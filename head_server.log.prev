[req] tool_call  call_276 shell({"command":"cd /Users/sean/Desktop/TenderPulseNZ && cat >> src/features/copilot/design/app.css << 'EOF'\n\n/* ─────────────────────────────────────────────────────────────────────────\n * Real-data states: honest error / empty / no-tenant cards, org switcher,\n * and vault category count chips. Component classes only — no token changes.\n * ───────────────────────────────────────────────────────────────────────── */\n.state-card {\n  display: flex;\n  align-items: flex-start;\n  gap: var(--space-3);\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-left: 4px solid var(--primary-navy);\n  border-radius: var(--radius-md);\n  padding: var(--space-4) var(--space-5);\n  color: var(--fg-2);\n  font-size: var(--fs-sm);\n  line-height: 1.6;\n  box-shadow: var(--shadow-sm);\n  flex-direction: row;\n}\n.state-card a { color: var(--accent); font-weight: 600; }\n.state-card-error {\n  border-left-color: var(--badge-critical-fg);\n  background: var(--surface);\n}\n.state-card-error .text-mono { color: var(--meta); word-break: break-word; }\n\n/* Org switcher (copilot header) */\n.org-switcher {\n  position: relative;\n  margin-left: var(--space-3);\n}\n.org-switcher-note {\n  margin: 0;\n  font-size: var(--fs-xs);\n  color: var(--muted);\n}\n.org-switcher-summary {\n  list-style: none;\n  display: inline-flex;\n  align-items: center;\n  gap: 6px;\n  cursor: pointer;\n  font-size: var(--fs-xs);\n  font-weight: 600;\n  color: var(--primary-navy);\n  background: var(--primary-navy-soft);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-pill);\n  padding: 4px 12px;\n}\n.org-switcher-summary::-webkit-details-marker { display: none; }\n.org-switcher-summary:hover { background: var(--accent-soft); }\n.org-switcher-count {\n  background: var(--primary-navy);\n  color: #FFFFFF;\n  border-radius: var(--radius-pill);\n  padding: 0 6px;\n  font-family: var(--font-mono);\n  font-size: 10px;\n}\n.org-switcher-panel {\n  position: absolute;\n  top: calc(100% + 6px);\n  left: 0;\n  z-index: 60;\n  min-width: 320px;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-md);\n  box-shadow: var(--shadow-lg);\n  padding: var(--space-2);\n}\n.org-switcher-list {\n  list-style: none;\n  margin: 0;\n  padding: 0;\n  display: flex;\n  flex-direction: column;\n}\n.org-switcher-item {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: var(--space-3);\n  padding: var(--space-2);\n  border-radius: var(--radius-sm);\n}\n.org-switcher-item.current {\n  background: var(--accent-soft);\n  border: 1px solid var(--accent);\n}\n.org-switcher-info {\n  display: flex;\n  flex-direction: column;\n  min-width: 0;\n}\n.org-switcher-name {\n  font-weight: 600;\n  font-size: var(--fs-sm);\n  color: var(--primary-navy);\n  overflow: hidden;\n  text-overflow: ellipsis;\n  white-space: nowrap;\n}\n.org-switcher-meta {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  color: var(--meta);\n}\n.org-switcher-btn {\n  flex-shrink: 0;\n  padding: 4px 10px;\n  font-size: var(--fs-xs);\n}\n\n/* Vault tab: per-category count chips */\n.vault-category-summary {\n  display: flex;\n  flex-wrap: wrap;\n  gap: var(--space-2);\n  margin-bottom: var(--space-4);\n}\n.vault-count-chip {\n  font-family: var(--font-mono);\n  font-size: 11px;\n  color: var(--meta);\n  border: 1px solid var(--border);\n  border-radius: var(--radius-pill);\n  padding: 3px 10px;\n  background: var(--surface);\n}\n.vault-count-chip.has-docs {\n  color: var(--accent);\n  border-color: var(--accent);\n  background: var(--accent-soft);\n}\n.vault-count-chip.total {\n  color: var(--primary-navy);\n  border-color: var(--primary-navy);\n  background: var(--primary-navy-soft);\n}\nEOF\necho appended"})
