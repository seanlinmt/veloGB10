[req] tool_call  call_401 edit({"path":"/Users/sean/Desktop/TenderPulseNZ/src/services/gets/run.ts","oldString":"  const db = getAdminClient();\n  const summary = await runIngestPipeline(db);\n\n  // eslint-disable-next-line no-console\n  console.log(JSON.stringify(summary, null, 2));\n\n  if (summary.feedsFailed > 0 || summary.errors.length > 0) {\n    process.exitCode = 1;\n  }\n}","newString":"  const db = getAdminClient();\n  const summary = await runIngestPipeline(db);\n\n  // eslint-disable-next-line no-console\n  console.log(JSON.stringify(summary, null, 2));\n\n  // §2 wiring: after the ingest tick, trigger the matching scorer across the\n  // whole fleet — every tenant × the fresh/unscored lots (see\n  // `scoreLotsForAllOrgs` for the enumeration + cost caps). It never throws;\n  // enumeration/per-pair failures land in its summary, so we surface them via\n  // the worker's exit code without losing the tick's ingest results.\n  const scoring = await scoreLotsForAllOrgs(db);\n\n  // eslint-disable-next-line no-console\n  console.log(JSON.stringify(scoring, null, 2));\n\n  if (\n    summary.feedsFailed > 0 ||\n    summary.errors.length > 0 ||\n    scoring.errors.length > 0\n  ) {\n    process.exitCode = 1;\n  }\n}"})
