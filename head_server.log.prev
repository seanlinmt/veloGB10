[req] tool_call  call_181 write({"content":"\"use client\";\n\nimport { useRef } from \"react\";\nimport { switchActiveOrganization } from \"@/features/auth/actions\";\nimport type { MembershipView } from \"../server/types\";\n\n/**\n * Organisation switcher — copilot header control.\n *\n * Lists the signed-in user's ACTIVE `organization_members` memberships and\n * switches the active tenant through the `switchActiveOrganization` server\n * action, which re-validates membership server-side before persisting the\n * `tp_active_org_id` cookie. No client-side trust: each entry is a plain\n * form + submit button, so it is fully keyboard-operable without custom JS.\n *\n * Accessibility: the disclosure `<summary>` carries the accessible name\n * (\"Switch organisation\"), every switch button is labelled with its\n * organisation, the active membership is marked with `aria-current=\"true\"`,\n * and the current org's button is honestly disabled (never a fake no-op).\n *\n * The `<details>` disclosure is native HTML: Tab reaches the summary,\n * Enter/Space open it, Tab then reaches each switch button, Escape-free\n * outside-click is unnecessary. The panel closes on submit so the switcher\n * never sits open after a tenant change.\n */\ninterface OrgSwitcherProps {\n  memberships: MembershipView[];\n  membershipsError: string | null;\n  activeOrgId: string;\n}\n\nconst ROLE_LABELS: Record<string, string> = {\n  admin: \"Administrator\",\n  bid_manager: \"Bid manager\",\n  viewer: \"Viewer\",\n};\n\nfunction roleLabel(role: string): string {\n  return ROLE_LABELS[role] ?? role;\n}\n\nexport function OrgSwitcher({\n  memberships,\n  membershipsError,\n  activeOrgId,\n}: OrgSwitcherProps) {\n  const detailsRef = useRef<HTMLDetailsElement>(null);\n\n  if (membershipsError) {\n    return (\n      <p className=\"org-switcher-note\" role=\"status\">\n        Organisation list unavailable — {membershipsError}\n      </p>\n    );\n  }\n\n  if (memberships.length === 0) {\n    return (\n      <p className=\"org-switcher-note\" role=\"status\">\n        No active organisation memberships on this account.\n      </p>\n    );\n  }\n\n  const closePanel = () => {\n    if (detailsRef.current) detailsRef.current.open = false;\n  };\n\n  return (\n    <details\n      ref={detailsRef}\n      className=\"org-switcher\"\n      data-od-id=\"org-switcher\"\n      onBlur={(e) => {\n        // Close when focus leaves the disclosure entirely (keyboard users can\n        // Escape-tab out; mouse users click elsewhere via the browser toggle).\n        if (!e.currentTarget.contains(e.relatedTarget as Node | null)) {\n          closePanel();\n        }\n      }}\n    >\n      <summary className=\"org-switcher-summary\">\n        <span aria-hidden=\"true\">⇄</span>\n        Switch organisation\n        <span className=\"org-switcher-count\">{memberships.length}</span>\n      </summary>\n\n      <div className=\"org-switcher-panel\">\n        <ul className=\"org-switcher-list\">\n          {memberships.map((m) => {\n            const isCurrent = m.organizationId === activeOrgId;\n            return (\n              <li\n                key={m.organizationId}\n                className={`org-switcher-item${isCurrent ? \" current\" : \"\"}`}\n                aria-current={isCurrent ? \"true\" : undefined}\n              >\n                <div className=\"org-switcher-info\">\n                  <span className=\"org-switcher-name\">{m.organizationName}</span>\n                  <span className=\"org-switcher-meta\">\n                    NZBN {m.nzbn} · {roleLabel(m.role)}\n                  </span>\n                </div>\n                <form\n                  action={switchActiveOrganization.bind(null, m.organizationId)}\n                  onSubmit={closePanel}\n                  aria-label={`Switch to ${m.organizationName}`}\n                >\n                  <button\n                    type=\"submit\"\n                    className=\"btn btn-secondary org-switcher-btn\"\n                    disabled={isCurrent}\n                    title={\n                      isCurrent\n                        ? \"This organisation is already active\"\n                        : `Switch the active organisation to ${m.organizationName}`\n                    }\n                  >\n                    {isCurrent ? \"Current\" : \"Switch to this organisation\"}\n                  </button>\n                </form>\n              </li>\n            );\n          })}\n        </ul>\n      </div>\n    </details>\n  );\n}","path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/ui/org-switcher.tsx"})
