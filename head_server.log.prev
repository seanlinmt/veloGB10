[req] tool_call  call_174 edit({"newString":"export async function loadLatestBid(\n  orgId: string,\n): Promise<LoaderResult<BidDetail | null>> {\n  const db = getAdminClient();\n  const res = await db\n    .from(\"bid_proposals\")\n    .select(\"id\")\n    .eq(\"org_id\", orgId)\n    .order(\"updated_at\", { ascending: false })\n    .limit(1)\n    .maybeSingle();\n  if (res.error) {\n    log(\"copilot\", \"bid_proposals.fetch failed\", { orgId, error: res.error.message });\n    return { ok: false, error: `bid_proposals.fetch failed: ${res.error.message}` };\n  }\n  const row = (res.data as { id: string } | null) ?? null;\n  if (!row) return { ok: true, data: null };\n  return loadBidDetail(row.id, orgId);\n}\n\n/* -------------------------------------------------------------------------- */\n/* Organization, membership & vault-overview loaders                          */\n/* -------------------------------------------------------------------------- */\n\n/** Row shape for the `organizations` table we read for the header. */\ninterface OrganizationRow {\n  id: string;\n  legal_name: string;\n  trading_name: string | null;\n  nzbn: string;\n  gst_registered: boolean;\n  is_amotai_certified: boolean;\n}\n\n/** Row shape for `organization_members` joined to its `organizations` row. */\ninterface MembershipRow {\n  organization_id: string;\n  user_role: string;\n  organizations: { nzbn: string; legal_name: string } | null;\n}\n\n/** Row shape for the vault-document summary we read for the vault tab. */\ninterface VaultDocumentSummaryRow {\n  id: string;\n  category: string;\n  title: string;\n  description: string | null;\n  valid_until: string | null;\n  metadata: Record<string, unknown> | null;\n  updated_at: string;\n}\n\n/** Display cap for vault documents surfaced on the copilot vault tab. */\nconst VAULT_DOC_DISPLAY_LIMIT = 50;\n\n/**\n * Load the active tenant's registered organization profile.\n *\n * Reads the single `organizations` row identified by the middleware-verified\n * tenant id so the dashboard header can show the real legal/trading name and\n * NZBN instead of prototype copy. Returns `ok: false` (never throws) when the\n * row is missing or the fetch fails; the header renders an honest\n * \"unavailable\" state from that.\n */\nexport async function loadActiveOrganization(\n  orgId: string,\n): Promise<LoaderResult<OrganizationView>> {\n  const db = getAdminClient();\n  const res = await db\n    .from(\"organizations\")\n    .select(\"id, legal_name, trading_name, nzbn, gst_registered, is_amotai_certified\")\n    .eq(\"id\", orgId)\n    .maybeSingle();\n  if (res.error) {\n    log(\"copilot\", \"organizations.fetch failed\", { orgId, error: res.error.message });\n    return { ok: false, error: `organizations.fetch failed: ${res.error.message}` };\n  }\n  const row = (res.data as OrganizationRow | null) ?? null;\n  if (!row) {\n    return { ok: false, error: \"organizations.fetch returned no row for this tenant\" };\n  }\n  return {\n    ok: true,\n    data: {\n      id: row.id,\n      legalName: row.legal_name,\n      tradingName: row.trading_name,\n      nzbn: row.nzbn,\n      gstRegistered: row.gst_registered,\n      isAmotaiCertified: row.is_amotai_certified,\n    },\n  };\n}\n\n/**\n * Load the signed-in user's ACTIVE organization memberships for the switcher.\n *\n * Resolves the session user via `getSessionUserId()` (GoTrue-verified, never a\n * client claim) and reads `organization_members` joined to `organizations`.\n * Domain auth errors surface as `{ ok: false, error }` rather than throwing to\n * the browser, matching the action/loader unions. The switcher then lists\n * these memberships and marks the active one; switching goes through the\n * `switchActiveOrganization` server action, which re-validates membership.\n */\nexport async function loadUserMemberships(): Promise<LoaderResult<MembershipView[]>> {\n  let userId: string | null;\n  try {\n    userId = await getSessionUserId();\n  } catch (err) {\n    if (\n      err instanceof UnauthorizedTenantAccessError ||\n      err instanceof UnauthenticatedSessionError\n    ) {\n      return { ok: false, error: err.message };\n    }\n    throw err;\n  }\n  if (!userId) {\n    return { ok: false, error: \"No authenticated session found for this request.\" };\n  }\n\n  const db = getAdminClient();\n  const res = await db\n    .from(\"organization_members\")\n    .select(\"organization_id, user_role, organizations(nzbn, legal_name)\")\n    .eq(\"user_id\", userId)\n    .eq(\"is_active\", true)\n    .order(\"created_at\", { ascending: true });\n  if (res.error) {\n    log(\"copilot\", \"organization_members.fetch failed\", {\n      userId,\n      error: res.error.message,\n    });\n    return { ok: false, error: `organization_members.fetch failed: ${res.error.message}` };\n  }\n\n  const rows = (res.data ?? []) as MembershipRow[];\n  const memberships: MembershipView[] = [];\n  for (const row of rows) {\n    // Defensive: skip a membership whose organization row is missing.\n    if (!row.organizations) continue;\n    memberships.push({\n      organizationId: row.organization_id,\n      organizationName: row.organizations.legal_name,\n      nzbn: row.organizations.nzbn,\n      role: row.user_role,\n    });\n  }\n  return { ok: true, data: memberships };\n}\n\n/**\n * Load a per-organization vault overview for the copilot \"Compliance Vault\"\n * tab: the tenant's document rows (newest first, display-capped) plus honest\n * per-category counts derived from the full result set.\n *\n * Mirrors the query shape of `listVaultDocuments()` in the vault server\n * actions: an explicit `org_id` scope on the service-role client as a\n * belt-and-braces tenant guard. Read-only; never throws — failures surface as\n * `{ ok: false, error }` so the screen renders an honest error state instead\n * of mock certificates.\n */\nexport async function loadVaultOverview(\n  orgId: string,\n): Promise<LoaderResult<VaultOverview>> {\n  const db = getAdminClient();\n  const res = await db\n    .from(\"sme_vault_documents\")\n    .select(\n      \"id, category, title, description, valid_until, metadata, updated_at\",\n      { count: \"exact\" },\n    )\n    .eq(\"org_id\", orgId)\n    .order(\"updated_at\", { ascending: false });\n  if (res.error) {\n    log(\"copilot\", \"sme_vault_documents.fetch failed\", { orgId, error: res.error.message });\n    return {\n      ok: false,\n      error: `sme_vault_documents.fetch failed: ${res.error.message}`,\n    };\n  }\n\n  const rows = (res.data ?? []) as VaultDocumentSummaryRow[];\n\n  // Honest per-category counts over the full set (zeros included so the UI\n  // never implies a category exists when it is empty).\n  const categories: VaultCategoryCount[] = DOCUMENT_CATEGORIES.map((category) => ({\n    category,\n    count: rows.filter((r) => r.category === category).length,\n  }));\n  const known = new Set<string>(DOCUMENT_CATEGORIES);\n  const otherCount = rows.filter((r) => !known.has(r.category)).length;\n  if (otherCount > 0) categories.push({ category: \"other\", count: otherCount });\n\n  const documents: VaultDocumentView[] = rows\n    .slice(0, VAULT_DOC_DISPLAY_LIMIT)\n    .map((r) => {\n      const provider =\n        r.metadata && typeof r.metadata.provider === \"string\"\n          ? r.metadata.provider\n          : null;\n      return {\n        id: r.id,\n        category: r.category,\n        title: r.title,\n        description: r.description,\n        validUntil: r.valid_until,\n        provider,\n        updatedAt: r.updated_at,\n      };\n    });\n\n  return {\n    ok: true,\n    data: {\n      documents,\n      total: res.count ?? rows.length,\n      categories,\n    },\n  };\n}","oldString":"export async function loadLatestBid(\n  orgId: string,\n): Promise<LoaderResult<BidDetail | null>> {\n  const db = getAdminClient();\n  const res = await db\n    .from(\"bid_proposals\")\n    .select(\"id\")\n    .eq(\"org_id\", orgId)\n    .order(\"updated_at\", { ascending: false })\n    .limit(1)\n    .maybeSingle();\n  if (res.error) {\n    log(\"copilot\", \"bid_proposals.fetch failed\", { orgId, error: res.error.message });\n    return { ok: false, error: `bid_proposals.fetch failed: ${res.error.message}` };\n  }\n  const row = (res.data as { id: string } | null) ?? null;\n  if (!row) return { ok: true, data: null };\n  return loadBidDetail(row.id, orgId);\n}","path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/server/loaders.ts"})
