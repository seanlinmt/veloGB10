[req] tool_call  call_236 edit({"newString":"function CommercialGate({\n  signed,\n  pricingTotal,\n  approvedBy,\n  readOnly,\n  proposalLocked,\n  onOpen,\n  triggerRef,\n}: {\n  signed: boolean;\n  pricingTotal: number | null;\n  approvedBy: string | null;\n  /** True for a viewer role (read-only, mirroring the server sign-off gate). */\n  readOnly: boolean;\n  /** True once the proposal is locked (status === \"published\"). */\n  proposalLocked: boolean;\n  onOpen: () => void;\n  triggerRef: React.RefObject<HTMLButtonElement>;\n}) {\n  return (\n    <div className={`gated-review-banner${signed ? \" signed\" : \"\"}`} data-od-id=\"commercial-gate\">\n      <div className=\"review-info\">\n        <div className=\"review-icon\">\n          <IconWarning size={22} />\n        </div>\n        <div className=\"review-text\">\n          <h4>\n            {signed\n              ? \"Commercial Sign-off Recorded\"\n              : \"Gated Commercial Review Required\"}\n          </h4>\n          <p>\n            {signed ? (\n              <>\n                Signed at {pricingTotal === null ? \"—\" : formatNZD(pricingTotal)}.{\" \"}\n                {approvedBy ? (\n                  <>\n                    Approved by{\" \"}\n                    <span className=\"text-mono\" title={approvedBy}>\n                      {shortId(approvedBy)}\n                    </span>\n                    .{\" \"}\n                  </>\n                ) : null}\n                Export package unlocked and hash logged to the NZISM ledger.\n              </>\n            ) : readOnly ? (\n              \"Commercial pricing must be approved by a Bid Manager or Administrator before the export package unlocks. Your role is read-only.\"\n            ) : (\n              \"Commercial pricing must be approved by an Authorized Bid Manager before the export package unlocks.\"\n            )}\n          </p>\n        </div>\n      </div>\n      <button\n        type=\"button\"\n        className=\"btn btn-secondary\"\n        ref={triggerRef}\n        onClick={onOpen}\n        disabled={proposalLocked}\n      >\n        {signed ? \"View Sign-off\" : \"Detail Modal\"}\n      </button>\n    </div>\n  );\n}","oldString":"function CommercialGate({\n  signed,\n  pricingTotal,\n  onOpen,\n  onToggleSign,\n  triggerRef,\n}: {\n  signed: boolean;\n  pricingTotal: number | null;\n  onOpen: () => void;\n  onToggleSign?: (checked: boolean) => void;\n  triggerRef: React.RefObject<HTMLButtonElement>;\n}) {\n  return (\n    <div className={`gated-review-banner${signed ? \" signed\" : \"\"}`} data-od-id=\"commercial-gate\">\n      <div className=\"review-info\">\n        <div className=\"review-icon\">\n          <IconWarning size={22} />\n        </div>\n        <div className=\"review-text\">\n          <h4>\n            {signed\n              ? \"Commercial Margins Approved\"\n              : \"Gated Commercial Review Required\"}\n          </h4>\n          <p>\n            {signed\n              ? `Signed at ${formatNZD(pricingTotal ?? 482500)}. Export package unlocked and hash logged to NZISM ledger.`\n              : \"Commercial pricing margins ($482,500 NZD @ 14.8% gross margin) must be approved by an Authorized Bid Manager before export unlocks.\"}\n          </p>\n        </div>\n      </div>\n      <div style={{ display: \"flex\", alignItems: \"center\", gap: 12 }}>\n        <label\n          className=\"signo-label\"\n          style={{ display: \"inline-flex\", alignItems: \"center\", gap: 6, cursor: \"pointer\", fontWeight: 500 }}\n        >\n          <input\n            type=\"checkbox\"\n            checked={signed}\n            onChange={(e) => onToggleSign?.(e.target.checked)}\n            style={{ width: 18, height: 18, accentColor: \"var(--accent)\" }}\n          />\n          Confirm Margins & Sign\n        </label>\n        <button\n          type=\"button\"\n          className=\"btn btn-secondary\"\n          ref={triggerRef}\n          onClick={onOpen}\n          disabled={signed}\n        >\n          {signed ? \"View Sign-off\" : \"Detail Modal\"}\n        </button>\n      </div>\n    </div>\n  );\n}","path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/ui/bid-drafter-screen.tsx"})
