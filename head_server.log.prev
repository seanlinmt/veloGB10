[req] tool_call  call_226 edit({"newString":"  /**\n   * Explicit \"Lock proposal\" HITL gate. `lockProposalAction` re-checks the\n   * `bid_manager`/`admin` role, every mandatory section's human review, and\n   * the commercial sign-off server-side; failures surface honestly in the\n   * alert below and never flip the local locked state.\n   */\n  const handleLockProposal = async () => {\n    setLockPending(true);\n    setLockError(null);\n    const res = await lockProposalAction(bid.bidId);\n    setLockPending(false);\n    if (!res.ok) {\n      setLockError(res.error);\n      return;\n    }\n    setProposalLocked(true);\n    setSections((prev) => prev.map((s) => ({ ...s, isLocked: true })));\n  };","oldString":"  const handleToggleSign = (checked: boolean) => {\n    if (checked) {\n      setCommercialSignoff({\n        id: \"local-signoff\",\n        pricingTotal: 482500,\n        approvedBy: \"W. Tane (Bid Mgr)\",\n        signoffTimestamp: new Date().toISOString(),\n      });\n    } else {\n      setCommercialSignoff(null);\n    }\n  };","path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/ui/bid-drafter-screen.tsx"})
