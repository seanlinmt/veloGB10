[req] tool_call  call_197 edit({"newString":"import { navItems } from \"../data/mock\";\nimport type { BadgeKind, ViewKey } from \"../data/mock\";\nimport {\n  IconOpportunities,\n  IconVault,\n  IconBid,\n  IconAudit,\n  IconTokens,\n  IconCheck,\n} from \"./icons\";\nimport { StatusBadge } from \"./status-badge\";\n\nconst iconMap = {\n  opportunities: IconOpportunities,\n  vault: IconVault,\n  bid: IconBid,\n  audit: IconAudit,\n  tokens: IconTokens,\n} as const;\n\nfunction NavBadge({ kind, text }: { kind: BadgeKind; text: string | null }) {\n  if (!text) return null;\n  if (kind) {\n    return (\n      <StatusBadge\n        text={text}\n        kind={kind === \"active\" ? \"active\" : \"warn\"}\n        style={{ padding: \"1px 6px\", fontSize: 10 }}\n      />\n    );\n  }\n  return <span className=\"nav-badge\">{text}</span>;\n}\n\n/**\n * Copilot sidebar navigation.\n *\n * The `ul[role=\"tablist\"]` keeps `role=\"presentation\"` on its `<li>` children\n * so axe's `aria-required-children` / `aria-required-parent` / `listitem`\n * rules stay satisfied. Nav badges are NOT static mock claims: the shell\n * passes `badges` derived from real loaded data, and items without a real\n * badge render none.\n */\nexport function Sidebar({\n  activeView,\n  onSelect,\n  badges,\n}: {\n  activeView: ViewKey;\n  onSelect: (key: ViewKey) => void;\n  badges?: Partial<Record<ViewKey, { text: string; kind: BadgeKind }>>;\n}) {\n  return (\n    <aside className=\"app-sidebar\" role=\"navigation\" aria-label=\"Main Navigation\">\n      <div>\n        <div className=\"nav-label\">Core Modules</div>\n        <ul className=\"nav-list\" role=\"tablist\">\n          {navItems.map((item) => {\n            const Icon = iconMap[item.icon];\n            const active = activeView === item.key;\n            const badge = badges?.[item.key] ?? null;\n            return (\n              <li className=\"nav-item\" role=\"presentation\" key={item.key}>\n                <button\n                  type=\"button\"\n                  className={active ? \"active\" : \"\"}\n                  role=\"tab\"\n                  aria-selected={active}\n                  aria-controls={`view-${item.key}`}\n                  onClick={() => onSelect(item.key)}\n                >\n                  <span className=\"nav-item-content\">\n                    <Icon size={18} />\n                    <span>{item.label}</span>\n                  </span>\n                  <NavBadge kind={badge?.kind ?? null} text={badge?.text ?? null} />\n                </button>\n              </li>\n            );\n          })}\n        </ul>\n      </div>","oldString":"import { navItems } from \"../data/mock\";\nimport type { ViewKey } from \"../data/mock\";\nimport {\n  IconOpportunities,\n  IconVault,\n  IconBid,\n  IconAudit,\n  IconTokens,\n  IconCheck,\n} from \"./icons\";\nimport { StatusBadge } from \"./status-badge\";\n\nconst iconMap = {\n  opportunities: IconOpportunities,\n  vault: IconVault,\n  bid: IconBid,\n  audit: IconAudit,\n  tokens: IconTokens,\n} as const;\n\nfunction NavBadge({ kind, text }: { kind: string | null; text: string | null }) {\n  if (!text) return null;\n  if (kind) {\n    return (\n      <StatusBadge\n        text={text}\n        kind={kind === \"active\" ? \"active\" : \"warn\"}\n        style={{ padding: \"1px 6px\", fontSize: 10 }}\n      />\n    );\n  }\n  return <span className=\"nav-badge\">{text}</span>;\n}\n\nexport function Sidebar({\n  activeView,\n  onSelect,\n}: {\n  activeView: ViewKey;\n  onSelect: (key: ViewKey) => void;\n}) {\n  return (\n    <aside className=\"app-sidebar\" role=\"navigation\" aria-label=\"Main Navigation\">\n      <div>\n        <div className=\"nav-label\">Core Modules</div>\n        <ul className=\"nav-list\" role=\"tablist\">\n          {navItems.map((item) => {\n            const Icon = iconMap[item.icon];\n            const active = activeView === item.key;\n            return (\n              <li className=\"nav-item\" role=\"presentation\" key={item.key}>\n                <button\n                  type=\"button\"\n                  className={active ? \"active\" : \"\"}\n                  role=\"tab\"\n                  aria-selected={active}\n                  aria-controls={`view-${item.key}`}\n                  onClick={() => onSelect(item.key)}\n                >\n                  <span className=\"nav-item-content\">\n                    <Icon size={18} />\n                    <span>{item.label}</span>\n                  </span>\n                  <NavBadge kind={item.badgeKind} text={item.badge} />\n                </button>\n              </li>\n            );\n          })}\n        </ul>\n      </div>","path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/ui/sidebar.tsx"})
