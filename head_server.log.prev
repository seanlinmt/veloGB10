[req] tool_call  call_385 edit({"newString":"# --- Check 4: TLS 1.2 absent (TLS 1.3 minimum claim) ----------------------------\n# SSP §2.5 / E-01 / Ch 17 17.4 claim \"TLS 1.3 minimum\" (the §2.5 cipher cell also\n# documents \"TLS 1.2 as fallback with AEAD only\" — a negotiated TLS 1.2 here means\n# edge and claim disagree; reconcile one of them before this output backs E-01).\n# (EC)DHE + AEAD-only compliance of any surviving 1.2 suites is Check 5's job.\nhandshake \"$TMP/tls12\" -tls1_2\nif grep -Eq 'Protocol *: *TLSv1\\.2' \"$TMP/tls12\"; then\n  fail \"TLS 1.2 negotiated — TLS 1.3 minimum claim not met (SSP §2.5 / E-01 / R-08); reconcile edge or claim wording\"\nelif grep -Eq 'Protocol *: *TLSv1\\.3' \"$TMP/tls12\"; then\n  # Client ignored -tls1_2 (old/limited build): inconclusive, not a pass.\n  inconclusive \"TLS 1.2 probe — local client did not restrict to TLS 1.2\"\nelif grep -Eq 'handshake failure|tlsv1 alert|no protocols available|unsupported protocol' \"$TMP/tls12\"; then\n  pass \"TLS 1.2 rejected (absent) — TLS 1.3-only edge, matches the documented claim\"\nelif grep -q 'BEGIN CERTIFICATE' \"$TMP/tls12\"; then\n  fail \"TLS 1.2 handshake succeeded — TLS 1.3 minimum claim not met (SSP §2.5 / E-01 / R-08)\"\nelse\n  inconclusive \"TLS 1.2 probe — local client may lack TLS 1.2 support ('$OPENSSL_VER')\"\nfi\n\n# --- Check 5: static-RSA key exchange absent (forward secrecy) ---------------","oldString":"# --- Check 4: static-RSA key exchange absent (forward secrecy) ---------------","path":"/Users/sean/Desktop/TenderPulseNZ/deploy/scripts/scan-tls.sh"})
[req] tool_call  call_386 edit({"newString":"# --- Checks 6+7: HSTS + CSP headers over the TLS connection -------------------","oldString":"# --- Checks 5+6: HSTS + CSP headers over the TLS connection -------------------","path":"/Users/sean/Desktop/TenderPulseNZ/deploy/scripts/scan-tls.sh"})
