[req] tool_call  call_191 write({"content":"\"use client\";\n\nimport { useState, useEffect } from \"react\";\nimport type { ReactNode } from \"react\";\nimport type { BadgeKind, ViewKey } from \"../data/mock\";\nimport type {\n  AuditLogEntry,\n  BidDetail,\n  LoaderResult,\n  MembershipView,\n  Opportunity,\n  OrganizationView,\n  VaultOverview,\n} from \"../server/types\";\nimport { Header } from \"./header\";\nimport { Sidebar } from \"./sidebar\";\nimport { OpportunitiesScreen } from \"./opportunities-screen\";\nimport { ComplianceVaultScreen } from \"./compliance-vault-screen\";\nimport { BidDrafterScreen } from \"./bid-drafter-screen\";\nimport { AuditLogScreen } from \"./audit-log-screen\";\nimport { DesignTokensScreen } from \"./design-tokens-screen\";\nimport { IconWarning } from \"./icons\";\n\n/**\n * Copilot dashboard shell — client component.\n *\n * Owns tab navigation and the active-view transient that is impossible (or\n * undesirable) to render from a Server Component. All data is loaded by the\n * parent Server Component (`(copilot)/dashboard/page.tsx`) as\n * {@link LoaderResult} unions and passed down here; there are NO mock\n * fallbacks. A failed load renders an honest error pane per tab, an empty\n * load renders the screen's own honest empty state, and the header shows the\n * real organization (or says it is unavailable). Server Actions are used only\n * for mutations (generate / review / lock / sign-off / export / org switch).\n */\ninterface AppShellProps {\n  orgId: string;\n  /** The active tenant's `organizations` row, or null when it failed to load. */\n  organization: OrganizationView | null;\n  organizationError: string | null;\n  /** The user's ACTIVE memberships for the org switcher (empty on failure). */\n  memberships: MembershipView[];\n  membershipsError: string | null;\n  /** Middleware-resolved tenant role (\"viewer\" | \"bid_manager\" | \"admin\"). */\n  userRole: string | null;\n  opportunities: LoaderResult<Opportunity[]>;\n  vault: LoaderResult<VaultOverview>;\n  auditEntries: LoaderResult<AuditLogEntry[]>;\n  bid: LoaderResult<BidDetail | null>;\n}\n\n/** Honest error pane for a tab whose loader returned `{ ok: false }`. */\nfunction PaneError({\n  viewKey,\n  title,\n  message,\n}: {\n  viewKey: ViewKey;\n  title: string;\n  message: string;\n}) {\n  return (\n    <section id={`view-${viewKey}`} role=\"tabpanel\" data-od-id={`screen-${viewKey}-error`}>\n      <div className=\"screen-header\">\n        <div>\n          <h1 className=\"screen-title\">{title}</h1>\n          <p className=\"screen-subtitle\">The data for this view could not be loaded.</p>\n        </div>\n      </div>\n      <div className=\"state-card state-card-error\" role=\"alert\">\n        <IconWarning size={18} />\n        <div>\n          <strong>Load failed.</strong> Nothing below is real until the query\n          succeeds — the message below comes straight from the server.\n          <div className=\"text-mono\" style={{ fontSize: \"var(--fs-xs)\", marginTop: \"var(--space-1)\" }}>\n            {message}\n          </div>\n        </div>\n      </div>\n    </section>\n  );\n}\n\nexport function AppShell({\n  orgId,\n  organization,\n  organizationError,\n  memberships,\n  membershipsError,\n  userRole,\n  opportunities,\n  vault,\n  auditEntries,\n  bid,\n}: AppShellProps) {\n  const [activeView, setActiveView] = useState<ViewKey>(\"opps\");\n\n  const handleNavigate = (viewKey: ViewKey) => setActiveView(viewKey);\n\n  // Move focus into the panel header for accessibility on view change.\n  useEffect(() => {\n    const panel = document.getElementById(`view-${activeView}`);\n    const h1 = panel?.querySelector(\"h1\");\n    if (h1) (h1 as HTMLElement).focus();\n  }, [activeView]);\n\n  // Real high-match count for the header (lots scored ≥ 80%); null when the\n  // opportunities load failed — the header then shows \"—\", never a fake 3.\n  const highMatchCount = opportunities.ok\n    ? opportunities.data.reduce(\n        (n, opp) => n + opp.lots.filter((lot) => lot.combinedScore >= 80).length,\n        0,\n      )\n    : null;\n\n  // Nav badges derived from real loaded data only — no invented \"New\" counts.\n  const navBadges: Partial<Record<ViewKey, { text: string; kind: BadgeKind }>> = {};\n  if (opportunities.ok && opportunities.data.length > 0) {\n    navBadges.opps = { text: String(opportunities.data.length), kind: null };\n  }\n  if (bid.ok && bid.data) {\n    navBadges.bid =\n      bid.data.status === \"published\"\n        ? { text: \"Locked\", kind: \"active\" }\n        : { text: \"Review\", kind: \"warn\" };\n  }\n\n  const ActiveScreen = (() => {\n    switch (activeView) {\n      case \"opps\":\n        return opportunities.ok ? (\n          <OpportunitiesScreen opportunities={opportunities.data} orgId={orgId} />\n        ) : (\n          <PaneError\n            viewKey=\"opps\"\n            title=\"GETS Opportunities & Unbundled Lots\"\n            message={opportunities.error}\n          />\n        );\n      case \"vault\":\n        return (\n          <ComplianceVaultScreen\n            vault={vault}\n            organization={organization}\n            organizationError={organizationError}\n          />\n        );\n      case \"bid\":\n        if (!bid.ok) {\n          return (\n            <PaneError\n              viewKey=\"bid\"\n              title=\"HITL Bid Drafter\"\n              message={bid.error}\n            />\n          );\n        }\n        return bid.data ? (\n          <BidDrafterScreen bid={bid.data} orgId={orgId} userRole={userRole} />\n        ) : (\n          <EmptyBidPane />\n        );\n      case \"audit\":\n        return auditEntries.ok ? (\n          <AuditLogScreen entries={auditEntries.data} orgId={orgId} />\n        ) : (\n          <PaneError\n            viewKey=\"audit\"\n            title=\"NZISM Chapter 14 Event Ledger\"\n            message={auditEntries.error}\n          />\n        );\n      case \"tokens\":\n        return <DesignTokensScreen />;\n    }\n  })();\n\n  return (\n    <>\n      <a\n        href=\"#main-content\"\n        className=\"skip-link\"\n        onClick={(e) => {\n          e.preventDefault();\n          const main = document.getElementById(\"main-content\");\n          if (main) main.focus();\n        }}\n      >\n        Skip to main content\n      </a>\n\n      <div className=\"app-shell\">\n        <Header\n          activeOrgId={orgId}\n          organization={organization}\n          organizationError={organizationError}\n          memberships={memberships}\n          membershipsError={membershipsError}\n          userRole={userRole}\n          highMatchCount={highMatchCount}\n          onShowOpportunities={() => handleNavigate(\"opps\")}\n        />\n        <Sidebar activeView={activeView} onSelect={handleNavigate} badges={navBadges} />\n\n        <main id=\"main-content\" className=\"main-canvas\" tabIndex={-1}>\n          {ActiveScreen}\n        </main>\n      </div>\n    </>\n  );\n}\n\n/** Friendly empty state for the bid pane when no bid has been started yet. */\nfunction EmptyBidPane(): ReactNode {\n  return (\n    <section id=\"view-bid\" role=\"tabpanel\" data-od-id=\"screen-bid-drafter\">\n      <div className=\"screen-header\">\n        <div>\n          <h1 className=\"screen-title\">HITL Bid Drafter</h1>\n          <p className=\"screen-subtitle\">\n            No bid proposal yet. Choose a high-match opportunity and start a bid\n            proposal to begin drafting.\n          </p>\n        </div>\n      </div>\n      <p className=\"screen-subtitle\" style={{ marginTop: \"var(--space-4)\" }}>\n        Head to <a href=\"/dashboard#view-opps\">Opportunities</a> and select\n        &ldquo;Start Bid Proposal&rdquo; on a lot to create your first proposal.\n      </p>\n    </section>\n  );\n}","path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/ui/app-shell.tsx"})
