[req] tool_call  call_417 edit({"newString":"  # ---- TLS: load the pre-provisioned wildcard cert ONLY when configured ----\n  # Conditional via Caddyfile text substitution: the `$(...)` inline command\n  # runs at Caddyfile LOAD time inside the Caddy container, so the `tls`\n  # directive below is emitted only when BOTH documented preconditions of the\n  # pre-provisioned mode hold — `CADDY_TLS_CREDS=true` (compose env) AND the\n  # cert files actually exist under /etc/caddy/certs. Otherwise it expands to\n  # nothing, so in the documented ACME mode (CADDY_TLS_CREDS=false with no\n  # deploy/certs/) Caddy auto-issues via ACME instead of aborting startup on\n  # missing cert files (the old unconditional `tls` line made that documented\n  # mode fatal). `|| true` keeps a false guard exit-0 so Caddyfile parsing\n  # never fails. Default local-cert mode (files present + flag true) behaves\n  # exactly as before: the same two cert paths are loaded.\n  $(test \"$CADDY_TLS_CREDS\" = true && test -f /etc/caddy/certs/wildcard.clearpixels.org.crt && test -f /etc/caddy/certs/wildcard.clearpixels.org.key && echo 'tls /etc/caddy/certs/wildcard.clearpixels.org.crt /etc/caddy/certs/wildcard.clearpixels.org.key' || true)","oldString":"  # ---- TLS: load the pre-provisioned wildcard cert when configured ----\n  tls /etc/caddy/certs/wildcard.clearpixels.org.crt /etc/caddy/certs/wildcard.clearpixels.org.key","path":"/Users/sean/Desktop/TenderPulseNZ/deploy/Caddyfile"})
