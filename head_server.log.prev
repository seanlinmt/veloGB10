[req] tool_call  call_164 edit({"path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/server/types.ts","oldString":"/** Discriminated-union result returned by the copilot server loaders. */\nexport type LoaderResult<T> =\n  | { ok: true; data: T }\n  | { ok: false; error: string };","newString":"/** Discriminated-union result returned by the copilot server loaders. */\nexport type LoaderResult<T> =\n  | { ok: true; data: T }\n  | { ok: false; error: string };\n\n/**\n * The active tenant's registered organization profile (`organizations` row).\n *\n * Surfaced verbatim from the synced NZBN record — legal name, trading name,\n * NZBN, GST status and Amotai certification — so the dashboard header shows\n * the real entity instead of prototype copy.\n */\nexport interface OrganizationView {\n  /** `organizations.id`. */\n  id: string;\n  /** `organizations.legal_name`. */\n  legalName: string;\n  /** `organizations.trading_name`, or null when not set. */\n  tradingName: string | null;\n  /** `organizations.nzbn` (13-digit). */\n  nzbn: string;\n  /** `organizations.gst_registered`. */\n  gstRegistered: boolean;\n  /** `organizations.is_amotai_certified`. */\n  isAmotaiCertified: boolean;\n}\n\n/**\n * One ACTIVE membership of the signed-in user, for the org switcher.\n *\n * Built from `organization_members` joined to `organizations`; the switcher\n * lists these and marks the currently active one.\n */\nexport interface MembershipView {\n  /** `organization_members.organization_id` (the switch target). */\n  organizationId: string;\n  /** `organizations.legal_name` of the membership's organization. */\n  organizationName: string;\n  /** `organizations.nzbn` of the membership's organization. */\n  nzbn: string;\n  /** `organization_members.user_role` (e.g. \"bid_manager\"). */\n  role: string;\n}\n\n/** A vault document surfaced on the copilot \"Compliance Vault\" tab. */\nexport interface VaultDocumentView {\n  /** `sme_vault_documents.id` (rendered shortened, never mocked). */\n  id: string;\n  /** `sme_vault_documents.category` (one of the vault categories). */\n  category: string;\n  /** `sme_vault_documents.title`. */\n  title: string;\n  /** `sme_vault_documents.description`. */\n  description: string | null;\n  /** `sme_vault_documents.valid_until` (YYYY-MM-DD) or null. */\n  validUntil: string | null;\n  /** `metadata.provider` (issuer / auditor) or null when not recorded. */\n  provider: string | null;\n  /** `sme_vault_documents.updated_at`, ISO-8601. */\n  updatedAt: string;\n}\n\n/** Number of vault documents stored under one category (zero included). */\nexport interface VaultCategoryCount {\n  /** Vault category key (e.g. \"insurance\"). */\n  category: string;\n  /** Count of the tenant's documents in this category. */\n  count: number;\n}\n\n/** Loader payload for the copilot vault tab: real rows + honest counts. */\nexport interface VaultOverview {\n  /** The most-recently-updated documents, capped for display. */\n  documents: VaultDocumentView[];\n  /** Total number of the tenant's vault documents. */\n  total: number;\n  /** Per-category counts covering every known category (zeros included). */\n  categories: VaultCategoryCount[];\n}"})
