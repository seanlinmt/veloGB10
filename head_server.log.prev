[req] tool_call  call_214 edit({"newString":"function SectionCard({\n  section,\n  isGenerating,\n  isLocking,\n  error,\n  readOnly,\n  proposalLocked,\n  onGenerate,\n  onLock,\n  onOpenCitation,\n}: {\n  section: BidSectionView;\n  isGenerating: boolean;\n  isLocking: boolean;\n  error: string | null;\n  /** True when the signed-in user's tenant role cannot drive HITL (viewer). */\n  readOnly: boolean;\n  /** True once the whole proposal is locked (status === \"published\"). */\n  proposalLocked: boolean;\n  onGenerate: () => void;\n  onLock: () => void;\n  onOpenCitation: (chunkId: string, x: number, y: number) => void;\n}) {\n  const sectionKey = section.sectionKey as BidSectionKey;\n  const hasContent = Boolean(section.generatedContent && section.generatedContent.trim().length > 0);\n  const controlsDisabled = readOnly || proposalLocked;\n\n  return (\n    <div className=\"bd-section-card\" data-od-id={`section-${sectionKey}`}>\n      <div className=\"bd-section-head\">\n        <div className=\"bd-section-title-wrap\">\n          <span className=\"bd-section-title\">{sectionDisplayName(section.sectionKey)}</span>\n          <span className=\"bd-section-meta\">\n            Confidence {confidenceLabel(section.confidenceScore)} ·{\" \"}\n            {section.citedVaultChunkIds.length} citations\n          </span>\n        </div>\n        <div className=\"bd-section-actions\">\n          {section.isLocked ? (\n            <span className=\"badge badge-active\">\n              <IconCheck size={12} />\n              Reviewed\n            </span>\n          ) : controlsDisabled ? (\n            <span className=\"badge badge-warn\">\n              {proposalLocked ? \"Locked with proposal\" : \"Awaiting review\"}\n            </span>\n          ) : (\n            <>\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary\"\n                onClick={onGenerate}\n                disabled={isGenerating || isLocking}\n              >\n                {isGenerating ? (\n                  <>\n                    <span className=\"bd-spinner\" aria-hidden=\"true\" /> Generating…\n                  </>\n                ) : (\n                  <>\n                    <IconRefresh size={14} />\n                    {hasContent ? \"Regenerate\" : \"Generate with Sovereign AI\"}\n                  </>\n                )}\n              </button>\n              <button\n                type=\"button\"\n                className=\"btn btn-primary\"\n                onClick={onLock}\n                disabled={isGenerating || isLocking || !hasContent}\n              >\n                {isLocking ? (\n                  <>\n                    <span className=\"bd-spinner\" aria-hidden=\"true\" /> Approving…\n                  </>\n                ) : (\n                  \"Approve & Lock\"\n                )}\n              </button>\n            </>\n          )}\n        </div>\n      </div>","oldString":"function SectionCard({\n  section,\n  isGenerating,\n  isLocking,\n  error,\n  onGenerate,\n  onLock,\n  onOpenCitation,\n}: {\n  section: BidSectionView;\n  isGenerating: boolean;\n  isLocking: boolean;\n  error: string | null;\n  onGenerate: () => void;\n  onLock: () => void;\n  onOpenCitation: (chunkId: string, x: number, y: number) => void;\n}) {\n  const sectionKey = section.sectionKey as BidSectionKey;\n  const hasContent = Boolean(section.generatedContent && section.generatedContent.trim().length > 0);\n\n  return (\n    <div className=\"bd-section-card\" data-od-id={`section-${sectionKey}`}>\n      <div className=\"bd-section-head\">\n        <div className=\"bd-section-title-wrap\">\n          <span className=\"bd-section-title\">{sectionDisplayName(section.sectionKey)}</span>\n          <span className=\"bd-section-meta\">\n            Confidence {confidenceLabel(section.confidenceScore)} ·{\" \"}\n            {section.citedVaultChunkIds.length} citations\n          </span>\n        </div>\n        <div className=\"bd-section-actions\">\n          {section.isLocked ? (\n            <span className=\"badge badge-active\">\n              <IconCheck size={12} />\n              Reviewed\n            </span>\n          ) : (\n            <>\n              <button\n                type=\"button\"\n                className=\"btn btn-secondary\"\n                onClick={onGenerate}\n                disabled={isGenerating || isLocking}\n              >\n                {isGenerating ? (\n                  <>\n                    <span className=\"bd-spinner\" aria-hidden=\"true\" /> Generating…\n                  </>\n                ) : (\n                  <>\n                    <IconRefresh size={14} />\n                    {hasContent ? \"Regenerate\" : \"Generate with Sovereign AI\"}\n                  </>\n                )}\n              </button>\n              <button\n                type=\"button\"\n                className=\"btn btn-primary\"\n                onClick={onLock}\n                disabled={isGenerating || isLocking || !hasContent}\n              >\n                {isLocking ? (\n                  <>\n                    <span className=\"bd-spinner\" aria-hidden=\"true\" /> Approving…\n                  </>\n                ) : (\n                  \"Approve & Lock\"\n                )}\n              </button>\n            </>\n          )}\n        </div>\n      </div>","path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/ui/bid-drafter-screen.tsx"})
