[req] tool_call  call_207 write({"content":"\"use client\";\n\nimport type {\n  LoaderResult,\n  OrganizationView,\n  VaultDocumentView,\n  VaultOverview,\n} from \"@/features/copilot/server/types\";\nimport { IconUpload } from \"./icons\";\nimport { StatusBadge } from \"./status-badge\";\nimport { shortId } from \"./short-id\";\n\n/** Human-readable labels for vault categories (mirrors the vault module). */\nconst CATEGORY_LABELS: Record<string, string> = {\n  insurance: \"Insurance\",\n  health_safety: \"Health & Safety\",\n  case_study: \"Case study\",\n  policy: \"Policy\",\n  te_tiriti: \"Te Tiriti / Social procurement\",\n  financial: \"Financial\",\n  other: \"Other\",\n};\n\nfunction categoryLabel(category: string): string {\n  return CATEGORY_LABELS[category] ?? category;\n}\n\n/** Format a YYYY-MM-DD / ISO date as a NZ-local readable date. */\nfunction formatDate(value: string): string {\n  const date = new Date(value);\n  if (Number.isNaN(date.getTime())) return value;\n  return new Intl.DateTimeFormat(\"en-NZ\", {\n    timeZone: \"Pacific/Auckland\",\n    year: \"numeric\",\n    month: \"short\",\n    day: \"numeric\",\n  }).format(date);\n}\n\n/** Derive an honest expiry badge from a document's `valid_until` (or lack). */\nfunction expiryStatus(\n  validUntil: string | null,\n): { text: string; kind: \"active\" | \"warn\" | \"critical\" } {\n  if (!validUntil) return { text: \"No expiry recorded\", kind: \"active\" };\n  const until = new Date(`${validUntil}T23:59:59`);\n  if (Number.isNaN(until.getTime())) return { text: \"No expiry recorded\", kind: \"active\" };\n  const now = new Date();\n  if (until.getTime() < now.getTime()) return { text: \"Expired\", kind: \"critical\" };\n  const days = Math.ceil((until.getTime() - now.getTime()) / 86_400_000);\n  if (days <= 30) return { text: `Expires in ${days} days`, kind: \"warn\" };\n  return { text: `Valid to ${formatDate(validUntil)}`, kind: \"active\" };\n}\n\nfunction DocCard({ doc }: { doc: VaultDocumentView }) {\n  const status = expiryStatus(doc.validUntil);\n\n  const handleCopy = () => {\n    navigator.clipboard?.writeText(doc.id);\n    window.alert(`Document ID copied: ${doc.id}`);\n  };\n\n  return (\n    <div className=\"doc-card\" data-od-id={`vault-doc-${shortId(doc.id)}`}>\n      <div className=\"doc-card-header\">\n        <div>\n          <span className=\"doc-category\">{categoryLabel(doc.category)}</span>\n          <h3 className=\"doc-title\">{doc.title}</h3>\n        </div>\n        <StatusBadge text={status.text} kind={status.kind} />\n      </div>\n      <div className=\"doc-meta\">\n        {doc.provider ? (\n          <div>\n            <strong>Provider:</strong> {doc.provider}\n          </div>\n        ) : null}\n        {doc.validUntil ? (\n          <div>\n            <strong>Valid until:</strong> {formatDate(doc.validUntil)}\n          </div>\n        ) : null}\n        <div>\n          <strong>Last updated:</strong> {formatDate(doc.updatedAt)}\n        </div>\n      </div>\n      <div className=\"doc-actions\">\n        <span\n          className=\"text-mono\"\n          style={{ fontSize: 11, color: \"var(--muted)\" }}\n          title={doc.id}\n        >\n          [Vault: {shortId(doc.id)}]\n        </span>\n        <button\n          className=\"btn btn-ghost\"\n          type=\"button\"\n          style={{ padding: \"4px 8px\", fontSize: 12 }}\n          onClick={handleCopy}\n          aria-label={`Copy full document ID ${doc.id}`}\n        >\n          Copy Document ID\n        </button>\n      </div>\n    </div>\n  );\n}\n\n/** Real, read-only view of the tenant's synced NZBN business profile. */\nfunction RegistryProfileCard({\n  organization,\n  organizationError,\n}: {\n  organization: OrganizationView | null;\n  organizationError: string | null;\n}) {\n  return (\n    <div className=\"nzbn-sync-card\" data-od-id=\"nzbn-profile-card\">\n      <div className=\"nzbn-left\">\n        <h2>Verified business profile (NZBN)</h2>\n        <p>\n          Read from your synced organisation record. Search the NZBN register\n          and re-sync directly from MBIE in the{\" \"}\n          <a href=\"/vault\" style={{ color: \"inherit\", fontWeight: 600 }}>\n            Compliance Vault\n          </a>\n          .\n        </p>\n      </div>\n      <div className=\"nzbn-sync-data\">\n        {organization ? (\n          <>\n            <div className=\"sync-row\">\n              <span className=\"sync-label\">Legal Name</span>\n              <span className=\"sync-val\">{organization.legalName}</span>\n            </div>\n            {organization.tradingName ? (\n              <div className=\"sync-row\">\n                <span className=\"sync-label\">Trading Name</span>\n                <span className=\"sync-val\">{organization.tradingName}</span>\n              </div>\n            ) : null}\n            <div className=\"sync-row\">\n              <span className=\"sync-label\">NZBN</span>\n              <span className=\"sync-val\">{organization.nzbn}</span>\n            </div>\n            <div className=\"sync-row\">\n              <span className=\"sync-label\">GST Registered</span>\n              <span className=\"sync-val\">\n                {organization.gstRegistered ? \"Yes\" : \"No\"}\n              </span>\n            </div>\n            <div className=\"sync-row\">\n              <span className=\"sync-label\">Amotai Certified</span>\n              <span className=\"sync-val\">\n                {organization.isAmotaiCertified ? \"Yes\" : \"Not recorded\"}\n              </span>\n            </div>\n          </>\n        ) : (\n          <div className=\"sync-row\">\n            <span className=\"sync-label\">Profile</span>\n            <span className=\"sync-val\">\n              {organizationError\n                ? `Unavailable — ${organizationError}`\n                : \"Not available for this organisation.\"}\n            </span>\n          </div>\n        )}\n      </div>\n    </div>\n  );\n}\n\n/**\n * Copilot \"Compliance Vault\" tab — real, loader-backed data only.\n *\n * Renders the tenant's actual vault documents and honest per-category counts\n * from `loadVaultOverview()` (same query shape as the vault's own\n * `listVaultDocuments()`), plus the real NZBN-synced organisation profile. A\n * failed load says so and points at /vault; an empty vault says \"No vault\n * documents yet\" — never mock certificates.\n */\nexport function ComplianceVaultScreen({\n  vault,\n  organization,\n  organizationError,\n}: {\n  vault: LoaderResult<VaultOverview>;\n  organization: OrganizationView | null;\n  organizationError: string | null;\n}) {\n  if (!vault.ok) {\n    return (\n      <section id=\"view-vault\" role=\"tabpanel\" data-od-id=\"screen-vault\">\n        <div className=\"screen-header\">\n          <div>\n            <h1 className=\"screen-title\">&ldquo;Tell the Government Once&rdquo; Compliance Vault</h1>\n            <p className=\"screen-subtitle\">\n              Your verified compliance credentials, grounded in the NZBN and\n              Companies Office records.\n            </p>\n          </div>\n        </div>\n        <div className=\"state-card state-card-error\" role=\"alert\">\n          <div>\n            <strong>Could not load your vault documents.</strong>{\" \"}\n            <span className=\"text-mono\" style={{ fontSize: \"var(--fs-xs)\" }}>\n              {vault.error}\n            </span>\n            <div style={{ marginTop: \"var(--space-2)\" }}>\n              Manage documents in the{\" \"}\n              <a href=\"/vault\" style={{ color: \"inherit\", fontWeight: 600 }}>\n                Compliance Vault\n              </a>\n              .\n            </div>\n          </div>\n        </div>\n      </section>\n    );\n  }\n\n  const { documents, total, categories } = vault.data;\n  const showingCap = documents.length < total;\n\n  return (\n    <section id=\"view-vault\" role=\"tabpanel\" data-od-id=\"screen-vault\">\n      <div className=\"screen-header\">\n        <div>\n          <h1 className=\"screen-title\">&ldquo;Tell the Government Once&rdquo; Compliance Vault</h1>\n          <p className=\"screen-subtitle\">\n            Single source of truth verified against the New Zealand Business\n            Number (NZBN) and Companies Office records. Grounds every bid claim\n            with cited evidence.\n          </p>\n        </div>\n        <a className=\"btn btn-secondary\" href=\"/vault/upload\">\n          <IconUpload size={16} />\n          Upload a document\n        </a>\n      </div>\n\n      <RegistryProfileCard\n        organization={organization}\n        organizationError={organizationError}\n      />\n\n      {total === 0 ? (\n        <div className=\"state-card\" role=\"status\">\n          No vault documents yet — upload your first compliance credential and\n          it will appear here, category counts included.{\" \"}\n          <a href=\"/vault\" style={{ color: \"inherit\", fontWeight: 600 }}>\n            Open the Compliance Vault\n          </a>\n          .\n        </div>\n      ) : (\n        <>\n          <div\n            className=\"vault-category-summary\"\n            aria-label=\"Vault document counts by category\"\n          >\n            {categories.map((c) => (\n              <span\n                key={c.category}\n                className={`vault-count-chip${c.count > 0 ? \" has-docs\" : \"\"}`}\n              >\n                {categoryLabel(c.category)} · {c.count}\n              </span>\n            ))}\n            <span className=\"vault-count-chip total\">Total · {total}</span>\n          </div>\n\n          <div className=\"doc-grid\">\n            {documents.map((doc) => (\n              <DocCard key={doc.id} doc={doc} />\n            ))}\n          </div>\n\n          {showingCap ? (\n            <p\n              className=\"text-mono\"\n              style={{ fontSize: \"var(--fs-xs)\", color: \"var(--muted)\", margin: 0 }}\n            >\n              Showing the {documents.length} most recently updated of {total}{\" \"}\n              documents — the counts above cover all of them.\n            </p>\n          ) : null}\n        </>\n      )}\n    </section>\n  );\n}","path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/ui/compliance-vault-screen.tsx"})
