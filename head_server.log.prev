[req] tool_call  call_404 edit({"newString":"/**\n * Build the compilation filename, e.g. `TenderPulse_gets-rfx-28914022_acme-ltd.docx`.\n */\nfunction buildFilename(frontMatter: ExportFrontMatter, format: ExportFormat): string {\n  const ext = EXPORT_FILE_EXTENSIONS[format];\n  const rfx = sanitizeFilenamePart(frontMatter.rfxReference);\n  const org = sanitizeFilenamePart(frontMatter.supplierLegalTradingName);\n  return `TenderPulse_${rfx}_${org}.${ext}`;\n}\n\n// -----------------------------------------------------------------------------\n// Post-compile artifact persistence (§2 wiring)\n// -----------------------------------------------------------------------------\n\n/**\n * Private Supabase Storage bucket holding compiled bid artifacts. Not part of\n * the init-migration seed buckets; it is lazily created (private) by\n * {@link persistExportArtifact} on the first successful export.\n */\nconst EXPORT_STORAGE_BUCKET = \"bid-exports\";\n\n/**\n * Persist a SUCCESSFULLY COMPILED artifact and record its storage path.\n *\n * Flow (called only from the post-gate success path of {@link doCompile}, so\n * a gated compile writes nothing — no object, no column update):\n *   1. Upload the buffer to the private `bid-exports` bucket via the\n *      service-role client. `upsert: true` routes through\n *      `storage.api.upsertObject`, so re-exporting the same bid + format\n *      overwrites the stored artifact (last successful compile wins).\n *      The object key is tenant-scoped (`{org_id}/{bid_id}/final.<ext>`) so\n *      objects can never collide across tenants.\n *   2. Lazily ensure the bucket: the bucket is not pre-provisioned by the\n *      init migration, so a failed upload triggers a single private\n *      `createBucket` + one upload retry (concurrent exports may race the\n *      create; the loser sees an \"already exists\" error but its retry\n *      succeeds).\n *   3. Write the object path into `bid_proposals.final_docx_path` bound by\n *      `id` AND `org_id` equality — the same bid↔tenant guard as the read\n *      (G1 non-negotiable): the service-role client bypasses RLS, so the\n *      explicit `org_id` equality is the belt-and-braces that stops a\n *      foreign-tenant bid from ever being stamped.\n *\n * NOTE on the column name: `final_docx_path` stores the path of the LAST\n * successfully persisted artifact for the bid — including a PDF export (the\n * key's extension reflects the actual format). Renaming the column is schema\n * backlog, out of scope here.\n *\n * Best-effort by design: the streaming export response is unchanged whether or\n * not persistence succeeds — storage/DB failures (including thrown SDK\n * errors) are logged and swallowed, the column is only stamped for artifacts\n * that truly landed, and a failed column write removes the uploaded object so\n * we never leak files without rows (mirrors the vault upload idiom). Returns\n * the persisted path, or `null` when nothing was persisted.\n */\nasync function persistExportArtifact(\n  db: SupabaseClient,\n  proposal: BidProposalRow,\n  format: ExportFormat,\n  buffer: Buffer,\n): Promise<string | null> {\n  const objectPath = `${proposal.org_id}/${proposal.id}/final.${EXPORT_FILE_EXTENSIONS[format]}`;\n  const uploadOptions = {\n    contentType: EXPORT_MIME_TYPES[format],\n    upsert: true,\n  };\n\n  try {\n    let upload = await db.storage\n      .from(EXPORT_STORAGE_BUCKET)\n      .upload(objectPath, buffer, uploadOptions);\n\n    if (upload.error) {\n      log(\"export\", \"bid-exports upload failed; ensuring bucket exists\", {\n        bidId: proposal.id,\n        error: upload.error.message,\n      });\n      const created = await db.storage.createBucket(EXPORT_STORAGE_BUCKET, {\n        public: false,\n      });\n      if (created.error) {\n        log(\"export\", \"bid-exports createBucket failed (may already exist)\", {\n          bidId: proposal.id,\n          error: created.error.message,\n        });\n      }\n      upload = await db.storage\n        .from(EXPORT_STORAGE_BUCKET)\n        .upload(objectPath, buffer, uploadOptions);\n      if (upload.error) {\n        log(\"export\", \"bid-exports upload retry failed; artifact not persisted\", {\n          bidId: proposal.id,\n          error: upload.error.message,\n        });\n        return null;\n      }\n    }\n\n    const update = await db\n      .from(\"bid_proposals\")\n      .update({ final_docx_path: objectPath })\n      .eq(\"id\", proposal.id)\n      .eq(\"org_id\", proposal.org_id);\n    if (update.error) {\n      log(\"export\", \"final_docx_path update failed; removing orphan object\", {\n        bidId: proposal.id,\n        error: update.error.message,\n      });\n      await db.storage.from(EXPORT_STORAGE_BUCKET).remove([objectPath]);\n      return null;\n    }\n\n    log(\"export\", \"export artifact persisted\", {\n      bidId: proposal.id,\n      storagePath: objectPath,\n    });\n    return objectPath;\n  } catch (err) {\n    log(\"export\", \"artifact persistence threw; export still streamed\", {\n      bidId: proposal.id,\n      error: err instanceof Error ? err.message : String(err),\n    });\n    return null;\n  }\n}","oldString":"/**\n * Build the compilation filename, e.g. `TenderPulse_gets-rfx-28914022_acme-ltd.docx`.\n */\nfunction buildFilename(frontMatter: ExportFrontMatter, format: ExportFormat): string {\n  const ext = EXPORT_FILE_EXTENSIONS[format];\n  const rfx = sanitizeFilenamePart(frontMatter.rfxReference);\n  const org = sanitizeFilenamePart(frontMatter.supplierLegalTradingName);\n  return `TenderPulse_${rfx}_${org}.${ext}`;\n}","path":"/Users/sean/Desktop/TenderPulseNZ/src/services/export/compiler.ts"})
