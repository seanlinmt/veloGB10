[req] tool_call  call_302 write({"content":"import type { Metadata } from \"next\";\nimport type { CSSProperties } from \"react\";\n\nexport const metadata: Metadata = {\n  title: \"TenderPulse NZ\",\n  description:\n    \"GETS tender intelligence, a verified compliance vault, and human-reviewed bid drafting for New Zealand SMEs.\",\n};\n\n/**\n * Public landing — minimal, honest, no data.\n *\n * Rendered by the root layout, outside both the Tailwind (dashboard) group and\n * the bespoke copilot design system, so it deliberately uses plain\n * self-contained inline styles: no Tailwind utility classes, no copilot CSS\n * tokens. No mock data and no tenant assumptions — middleware makes\n * `/dashboard` fail closed for anonymous visitors, so the dashboard link is a\n * sign-in path, presented as such.\n */\n\nconst page: CSSProperties = {\n  minHeight: \"100vh\",\n  display: \"grid\",\n  placeItems: \"center\",\n  padding: \"48px 24px\",\n  background: \"#F8FAFC\",\n  color: \"#0F172A\",\n};\n\nconst card: CSSProperties = {\n  width: \"100%\",\n  maxWidth: 560,\n  display: \"flex\",\n  flexDirection: \"column\",\n  gap: 20,\n  textAlign: \"center\",\n};\n\nconst title: CSSProperties = {\n  margin: 0,\n  fontSize: 30,\n  lineHeight: 1.2,\n  color: \"#0B2545\",\n};\n\nconst lede: CSSProperties = {\n  margin: 0,\n  fontSize: 16,\n  lineHeight: 1.6,\n  color: \"#334155\",\n};\n\nconst actions: CSSProperties = {\n  display: \"flex\",\n  flexWrap: \"wrap\",\n  gap: 12,\n  justifyContent: \"center\",\n};\n\nconst primaryLink: CSSProperties = {\n  display: \"inline-block\",\n  padding: \"12px 22px\",\n  borderRadius: 10,\n  background: \"#0B2545\",\n  color: \"#FFFFFF\",\n  fontWeight: 600,\n  textDecoration: \"none\",\n};\n\nconst secondaryLink: CSSProperties = {\n  display: \"inline-block\",\n  padding: \"12px 22px\",\n  borderRadius: 10,\n  border: \"1px solid #CBD5E1\",\n  background: \"#FFFFFF\",\n  color: \"#0B2545\",\n  fontWeight: 600,\n  textDecoration: \"none\",\n};\n\nconst footnote: CSSProperties = {\n  margin: 0,\n  fontSize: 12,\n  color: \"#5B6B7F\",\n};\n\nexport default function HomePage() {\n  return (\n    <main id=\"main\" style={page}>\n      <div style={card}>\n        <h1 style={title}>TenderPulse NZ</h1>\n        <p style={lede}>\n          GETS tender intelligence, a verified compliance vault, and\n          human-reviewed bid drafting for New Zealand SMEs — with tenant data\n          kept on-shore.\n        </p>\n        <nav style={actions} aria-label=\"Account entry\">\n          <a href=\"/login\" style={primaryLink}>\n            Sign in\n          </a>\n          <a href=\"/dashboard\" style={secondaryLink}>\n            Open dashboard (sign-in required)\n          </a>\n        </nav>\n        <p style={footnote}>Built for Aotearoa New Zealand government procurement.</p>\n      </div>\n    </main>\n  );\n}","path":"/Users/sean/Desktop/TenderPulseNZ/src/app/page.tsx"})
