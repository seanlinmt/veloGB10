[req] tool_call  call_223 edit({"newString":"export function BidDrafterScreen({\n  bid,\n  userRole,\n}: {\n  bid: BidDetail;\n  /** @deprecated Retained for call-site compatibility; the actions now derive\n   *  the tenant server-side via `requireOrgId()` instead of trusting this. */\n  orgId?: string;\n  /** Middleware-resolved tenant role. A `\"viewer\"` gets read-only HITL\n   *  treatment mirroring the server's `bid_manager`/`admin` role gate; when\n   *  absent (deep-link route) the server remains the gate. */\n  userRole?: string | null;\n}) {\n  const isViewer = userRole === \"viewer\";\n\n  const [sections, setSections] = useState<BidSectionView[]>(() => bid.sections);\n  const [commercialSignoff, setCommercialSignoff] = useState<BidSignoffView | null>(\n    () => bid.commercialSignoff,\n  );\n  // Honest proposal-level lock: seeded from the server status, flipped only\n  // after `lockProposalAction` succeeds.\n  const [proposalLocked, setProposalLocked] = useState<boolean>(\n    () => bid.status === \"published\",\n  );\n  const [lockPending, setLockPending] = useState(false);\n  const [lockError, setLockError] = useState<string | null>(null);\n\n  const [generatingKey, setGeneratingKey] = useState<string | null>(null);\n  const [lockingKey, setLockingKey] = useState<string | null>(null);\n  const [sectionErrors, setSectionErrors] = useState<Record<string, string>>({});\n\n  const [modalOpen, setModalOpen] = useState(false);\n  const [signoffPending, setSignoffPending] = useState(false);\n  const [signoffError, setSignoffError] = useState<string | null>(null);\n\n  const [exporting, setExporting] = useState<string | null>(null);\n  const [exportError, setExportError] = useState<string | null>(null);\n\n  const [popover, setPopover] = useState<PopoverState | null>(null);\n  const popoverRef = useRef<HTMLDivElement>(null);\n  const signoffTriggerRef = useRef<HTMLButtonElement>(null);\n\n  // Sync local working state when the loaded bid prop changes (e.g. re-fetch).\n  useEffect(() => {\n    setSections(bid.sections);\n    setCommercialSignoff(bid.commercialSignoff);\n    setProposalLocked(bid.status === \"published\");\n    setLockError(null);\n    setSectionErrors({});\n    setExportError(null);\n  }, [bid]);","oldString":"export function BidDrafterScreen({\n  bid,\n}: {\n  bid: BidDetail;\n  /** @deprecated Retained for call-site compatibility; the actions now derive\n   *  the tenant server-side via `requireOrgId()` instead of trusting this. */\n  orgId?: string;\n}) {\n  const [sections, setSections] = useState<BidSectionView[]>(() => bid.sections);\n  const [commercialSignoff, setCommercialSignoff] = useState<BidSignoffView | null>(\n    () => bid.commercialSignoff,\n  );\n\n  const [generatingKey, setGeneratingKey] = useState<string | null>(null);\n  const [lockingKey, setLockingKey] = useState<string | null>(null);\n  const [sectionErrors, setSectionErrors] = useState<Record<string, string>>({});\n\n  const [modalOpen, setModalOpen] = useState(false);\n  const [signoffPending, setSignoffPending] = useState(false);\n  const [signoffError, setSignoffError] = useState<string | null>(null);\n\n  const [exporting, setExporting] = useState<string | null>(null);\n  const [exportError, setExportError] = useState<string | null>(null);\n\n  const [popover, setPopover] = useState<PopoverState | null>(null);\n  const popoverRef = useRef<HTMLDivElement>(null);\n  const signoffTriggerRef = useRef<HTMLButtonElement>(null);\n\n  // Sync local working state when the loaded bid prop changes (e.g. re-fetch).\n  useEffect(() => {\n    setSections(bid.sections);\n    setCommercialSignoff(bid.commercialSignoff);\n    setSectionErrors({});\n    setExportError(null);\n  }, [bid]);","path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/ui/bid-drafter-screen.tsx"})
