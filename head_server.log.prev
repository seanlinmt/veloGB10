[req] tool_call  call_240 edit({"path":"/Users/sean/Desktop/TenderPulseNZ/src/services/matching/scorer.ts","oldString":"export function computeCombinedScore(\n  semanticFitScore: number,\n  hardCriteriaPassed: boolean,\n): number {\n  const criteriaFactor = hardCriteriaPassed ? 1 : 0;\n  const score = 100 * (SEMANTIC_WEIGHT * semanticFitScore + CRITERIA_WEIGHT * criteriaFactor);\n  return Math.round(clamp(score, 0, 100));\n}","newString":"export function computeCombinedScore(\n  semanticFitScore: number,\n  hardCriteriaPassed: boolean,\n): number {\n  const criteriaFactor = hardCriteriaPassed ? 1 : 0;\n  const score = 100 * (SEMANTIC_WEIGHT * semanticFitScore + CRITERIA_WEIGHT * criteriaFactor);\n  return Math.round(clamp(score, 0, 100));\n}\n\n// -----------------------------------------------------------------------------\n// Pipeline fan-out entrypoint (post-ingest scoring) — ADDITIVE (§2 wiring)\n// -----------------------------------------------------------------------------\n\n/**\n * Cap on the recency window of `tender_lots` considered per scoring run. The\n * ingest tick is meant to score freshly indexed lots, so a newest-first window\n * bounds the per-tick embedding cost regardless of total table size.\n */\nconst MAX_LOTS_PER_SCORING_RUN = 50;\n\n/** Cap on (org, lot) pairs scored per run (embedding-gateway budget guard). */\nconst MAX_PAIRS_PER_SCORING_RUN = 200;\n\n/** Summary of one whole-fleet scoring fan-out (never throws). */\nexport interface ScoringRunSummary {\n  startedAt: string;\n  finishedAt: string;\n  orgsScanned: number;\n  lotsScanned: number;\n  pairsScored: number;\n  pairsFailed: number;\n  alertsLogged: number;\n  errors: string[];\n}\n\n/**\n * Score every fresh/unscored lot for every tenant after an ingest tick.\n *\n * Enumeration (\"orgs with fresh/unscored lots\"):\n *   1. All tenants (`organizations.id`) — every SME should see new lots.\n *   2. The newest `MAX_LOTS_PER_SCORING_RUN` lots (`tender_lots.created_at`).\n *   3. Existing `tender_lot_matches` rows for those lots; the (org, lot) pairs\n *      WITHOUT a match row are the fresh/unscored work set.\n *\n * Each pair is scored by the existing `scoreTenderLotForTenant` entrypoint —\n * it uses the service-role `getAdminClient()` internally, keeps\n * `tender_lot_matches` as its write target, preserves HITL triage status on\n * re-score, and retains the ≥ `ALERT_THRESHOLD` (80) immutable audit-alert\n * behaviour. Pairs run SEQUENTIALLY so one tick cannot flood the sovereign\n * embedding gateway.\n *\n * `combined_score` itself is deliberately NOT persisted: `tender_lot_matches`\n * has no such column today (see init migration); adding one is §3 backlog\n * (migration + scoring write), out of scope here.\n *\n * Enumeration failures and per-pair scoring failures never throw — they land\n * in `summary.errors` / `pairsFailed` so the ingest worker can set its exit\n * code without losing the tick's partial results.\n */\nexport async function scoreLotsForAllOrgs(\n  db: ReturnType<typeof getAdminClient> = getAdminClient(),\n): Promise<ScoringRunSummary> {\n  const startedAt = new Date().toISOString();\n  const summary: ScoringRunSummary = {\n    startedAt,\n    finishedAt: \"\",\n    orgsScanned: 0,\n    lotsScanned: 0,\n    pairsScored: 0,\n    pairsFailed: 0,\n    alertsLogged: 0,\n    errors: [],\n  };\n\n  // 1. Tenant enumeration (service-role client bypasses RLS).\n  const orgsRes = await db.from(\"organizations\").select(\"id\");\n  if (orgsRes.error) {\n    logError(\"matching\", \"organizations.select failed (fan-out)\", orgsRes.error, {});\n    summary.errors.push(`organizations.select: ${orgsRes.error.message}`);\n    summary.finishedAt = new Date().toISOString();\n    return summary;\n  }\n  const orgIds = ((orgsRes.data ?? []) as Array<{ id: string }>).map((r) => r.id);\n  summary.orgsScanned = orgIds.length;\n\n  // 2. Newest-lot recency window.\n  const lotsRes = await db\n    .from(\"tender_lots\")\n    .select(\"id\")\n    .order(\"created_at\", { ascending: false })\n    .limit(MAX_LOTS_PER_SCORING_RUN);\n  if (lotsRes.error) {\n    logError(\"matching\", \"tender_lots.select failed (fan-out)\", lotsRes.error, {});\n    summary.errors.push(`tender_lots.select: ${lotsRes.error.message}`);\n    summary.finishedAt = new Date().toISOString();\n    return summary;\n  }\n  const lotIds = ((lotsRes.data ?? []) as Array<{ id: string }>).map((r) => r.id);\n  summary.lotsScanned = lotIds.length;\n\n  if (orgIds.length === 0 || lotIds.length === 0) {\n    summary.finishedAt = new Date().toISOString();\n    return summary;\n  }\n\n  // 3. Fresh/unscored pairs = (orgs × lots) minus existing match rows.\n  const matchesRes = await db\n    .from(\"tender_lot_matches\")\n    .select(\"org_id, lot_id\")\n    .in(\"lot_id\", lotIds);\n  if (matchesRes.error) {\n    logError(\"matching\", \"tender_lot_matches.select failed (fan-out)\", matchesRes.error, {});\n    summary.errors.push(`tender_lot_matches.select: ${matchesRes.error.message}`);\n    summary.finishedAt = new Date().toISOString();\n    return summary;\n  }\n  const existing = new Set(\n    ((matchesRes.data ?? []) as Array<{ org_id: string; lot_id: string }>).map(\n      (r) => `${r.org_id}:${r.lot_id}`,\n    ),\n  );\n\n  const pairs: Array<[string, string]> = [];\n  outer: for (const lotId of lotIds) {\n    for (const orgId of orgIds) {\n      if (existing.has(`${orgId}:${lotId}`)) continue;\n      pairs.push([orgId, lotId]);\n      if (pairs.length >= MAX_PAIRS_PER_SCORING_RUN) break outer;\n    }\n  }\n\n  // 4. Sequential per-pair scoring via the existing single-tenant entrypoint.\n  for (const [orgId, lotId] of pairs) {\n    const result = await scoreTenderLotForTenant(orgId, lotId);\n    if (result.ok) {\n      summary.pairsScored += 1;\n      if (result.match.alertLogged) summary.alertsLogged += 1;\n    } else {\n      summary.pairsFailed += 1;\n      summary.errors.push(`score ${orgId}:${lotId}: ${result.error}`);\n    }\n  }\n\n  log(\"matching\", \"Scoring fan-out complete\", {\n    orgsScanned: summary.orgsScanned,\n    lotsScanned: summary.lotsScanned,\n    pairsScored: summary.pairsScored,\n    pairsFailed: summary.pairsFailed,\n    alertsLogged: summary.alertsLogged,\n  });\n\n  summary.finishedAt = new Date().toISOString();\n  return summary;\n}"})
