[req] tool_call  call_175 write({"path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/ui/short-id.ts","content":"/**\n * Shorten a UUID-ish identifier for display: first 8 characters + an ellipsis.\n *\n * Reviewer / approver / document identities are auth user or row UUIDs. The\n * dashboard never invents display names for them — it shows the real id in\n * short form (with the full value available via a `title` attribute).\n */\nexport function shortId(id: string): string {\n  return id.length > 8 ? `${id.slice(0, 8)}…` : id;\n}"})
