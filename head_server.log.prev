[req] tool_call  call_202 write({"content":"// Shared static chrome for the TenderPulse copilot dashboard.\n//\n// This file carries ONLY presentational configuration (navigation structure,\n// design-spec swatches). It intentionally holds no fake tenant/business data:\n// every screen renders real loader-backed rows or an honest empty/error\n// state. `data/mock.ts` is a misnomer kept for import stability.\n\nexport type BadgeKind = \"active\" | \"warn\" | \"critical\" | null;\n\nexport interface NavItem {\n  key: ViewKey;\n  label: string;\n  icon: \"opportunities\" | \"vault\" | \"bid\" | \"audit\" | \"tokens\";\n}\n\nexport type ViewKey = \"opps\" | \"vault\" | \"bid\" | \"audit\" | \"tokens\";\n\nexport const navItems: NavItem[] = [\n  { key: \"opps\", label: \"Opportunities\", icon: \"opportunities\" },\n  { key: \"vault\", label: \"Compliance Vault\", icon: \"vault\" },\n  { key: \"bid\", label: \"HITL Bid Copilot\", icon: \"bid\" },\n  { key: \"audit\", label: \"NZISM Audit Log\", icon: \"audit\" },\n  { key: \"tokens\", label: \"Design System Spec\", icon: \"tokens\" },\n];\n\nexport interface ColorToken {\n  swatch: string;\n  name: string;\n  desc: string;\n  ratio: string;\n  bordered?: boolean;\n}\n\nexport const colorTokens: ColorToken[] = [\n  {\n    swatch: \"#0B2545\",\n    name: \"--primary-navy: #0B2545\",\n    desc: \"Civic Authority, Headers, High-Contrast\",\n    ratio: \"Contrast: 13.6:1 on White (Pass AAA)\",\n  },\n  {\n    swatch: \"#134E4A\",\n    name: \"--accent: #134E4A (Pounamu)\",\n    desc: \"Primary CTAs, Trust Actions\",\n    ratio: \"Contrast: 7.2:1 on White (Pass AAA)\",\n  },\n  {\n    swatch: \"#F8FAFC\",\n    name: \"--bg: #F8FAFC\",\n    desc: \"Neutral Page Canvas (Anti-Glare)\",\n    ratio: \"Contrast: 14.8:1 against Navy Text\",\n    bordered: true,\n  },\n  {\n    swatch: \"#CBD5E1\",\n    name: \"--border: #CBD5E1\",\n    desc: \"Structural Dividers & Cards\",\n    ratio: \"Contrast: 3.1:1 on Canvas (Pass AA)\",\n  },\n];","path":"/Users/sean/Desktop/TenderPulseNZ/src/features/copilot/data/mock.ts"})
